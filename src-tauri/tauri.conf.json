{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ieum-captions",
  "version": "0.1.0",
  "identifier": "dev.cyseo.ieumcaptions",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "이음",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ieum-server"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
